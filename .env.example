# Copy to .env and adjust. Every variable is described in docker/README.md.
# Lines starting with # are ignored. Do not quote values.

# ---- Container ---------------------------------------------------------------
REDMINE_PORT=3000
#REDMINE_IMAGE=redmine-custom:7.0.2

# ---- Application -------------------------------------------------------------
# Leave SECRET_KEY_BASE empty to have one generated and stored in the files volume.
#SECRET_KEY_BASE=
#RAILS_RELATIVE_URL_ROOT=/redmine
#RAILS_MAX_THREADS=5
#WEB_CONCURRENCY=0
#TZ=Asia/Tokyo

# ---- First boot --------------------------------------------------------------
REDMINE_LANG=en
REDMINE_LOAD_DEFAULT_DATA=true
#REDMINE_SKIP_DB_MIGRATE=false
#REDMINE_PLUGINS_MIGRATE=true
REDMINE_DB_WAIT_TIMEOUT=120

# ---- Database: pick exactly ONE block ----------------------------------------

# (a) SQLite - single container, data in the redmine-sqlite volume (default)
REDMINE_DB_ADAPTER=sqlite3

# (b) PostgreSQL - run with: docker compose --profile postgres up -d
#REDMINE_DB_ADAPTER=postgresql
#REDMINE_DB_HOST=postgres
#REDMINE_DB_PORT=5432
#REDMINE_DB_DATABASE=redmine
#REDMINE_DB_USERNAME=redmine
#REDMINE_DB_PASSWORD=redmine
#REDMINE_DB_SSLMODE=prefer

# (c) MySQL - run with: docker compose --profile mysql up -d
#REDMINE_DB_ADAPTER=mysql2
#REDMINE_DB_HOST=mysql
#REDMINE_DB_PORT=3306
#REDMINE_DB_DATABASE=redmine
#REDMINE_DB_USERNAME=redmine
#REDMINE_DB_PASSWORD=redmine

# (d) SQL Server - run with: docker compose --profile mssql up -d
#     The password must satisfy SQL Server complexity rules.
#REDMINE_DB_ADAPTER=sqlserver
#REDMINE_DB_HOST=mssql
#REDMINE_DB_PORT=1433
#REDMINE_DB_DATABASE=redmine
#REDMINE_DB_USERNAME=sa
#REDMINE_DB_PASSWORD=Redmine_Passw0rd!
#REDMINE_DB_ENCRYPT=false
#REDMINE_DB_TDS_VERSION=7.3
#REDMINE_DB_AZURE=false

# (e) An existing external database: use any block above with your own host,
#     or point REDMINE_DATABASE_YML at a complete database.yml mounted into
#     the container.
#REDMINE_DATABASE_YML=/run/secrets/database.yml

# ---- Outgoing mail (optional) ------------------------------------------------
#REDMINE_SMTP_ADDRESS=smtp.example.com
#REDMINE_SMTP_PORT=587
#REDMINE_SMTP_DOMAIN=example.com
#REDMINE_SMTP_USER_NAME=redmine@example.com
#REDMINE_SMTP_PASSWORD=
#REDMINE_SMTP_AUTHENTICATION=plain
#REDMINE_SMTP_ENABLE_STARTTLS_AUTO=true
#REDMINE_SMTP_OPENSSL_VERIFY_MODE=peer
#REDMINE_ATTACHMENTS_STORAGE_PATH=/usr/src/redmine/files
